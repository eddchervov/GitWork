<UserControl x:Class="GitWork.App.PreparationSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GitWork.App">
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,14,0,0">
    <StackPanel>
      <TextBlock Text="{local:Loc 'Подготовка после создания'}" FontWeight="SemiBold" Margin="0,0,0,8" />
      <CheckBox x:Name="RunCheck" Content="{local:Loc 'Запустить команды'}" Margin="0,0,0,8" />
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <ComboBox x:Name="ProfilePicker" DisplayMemberPath="Name" SelectionChanged="Profile_Changed" AutomationProperties.Name="{local:Loc 'Профиль подготовки'}" />
        <Button Grid.Column="1" Content="{local:Loc 'Настроить…'}" Click="Configure_Click" Margin="8,0,0,0" />
      </Grid>
      <CheckBox x:Name="GroupCheck" Margin="0,8,0,0" />
      <TextBlock x:Name="DirectoryHint" Style="{StaticResource Caption}" Margin="0,8,0,0" />
      <ItemsControl x:Name="StepsPreview" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" Margin="0,2" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock x:Name="ValidationText" Foreground="{DynamicResource WarningBrush}" Margin="0,5,0,0" />
    </StackPanel>
  </Border>
</UserControl>
