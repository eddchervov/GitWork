<Window x:Class="GitWork.App.StashWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GitWork.App" Title="{local:Loc 'Сохранённые изменения (stash)'}" Width="1280" Height="760" MinWidth="960" MinHeight="520" WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13" Loaded="Window_Loaded">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
      <StackPanel>
        <TextBox x:Name="WorktreePathText" Style="{StaticResource SelectableText}" FontWeight="SemiBold" />
        <TextBlock Text="{local:Loc 'Список stash общий для всех worktree этого репозитория. Применение выполняется в указанной рабочей копии.'}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Grid x:Name="CreatePanel" Grid.Row="1" Margin="16,12">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Grid>
        <TextBox x:Name="MessageBox" MaxLength="200" AutomationProperties.Name="{local:Loc 'Название сохранения'}" />
        <TextBlock Text="{local:Loc 'Название сохранения (необязательно)'}" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text.Length,ElementName=MessageBox}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </Grid>
      <CheckBox x:Name="IncludeUntrackedBox" Grid.Column="1" Content="{local:Loc 'Включить новые файлы'}" VerticalAlignment="Center" Margin="14,0" ToolTip="{local:Loc 'Игнорируемые файлы останутся в рабочей копии.'}" />
      <Button x:Name="CreateButton" Grid.Column="2" Content="{local:Loc 'Спрятать изменения'}" Click="Create_Click" />
    </Grid>
    <Grid x:Name="ContentPanel" Grid.Row="2" Margin="16,0,16,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="270" MinWidth="200" /><ColumnDefinition Width="7" /><ColumnDefinition Width="230" MinWidth="160" /><ColumnDefinition Width="7" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8"><Button x:Name="RefreshButton" Content="{local:Loc 'Обновить'}" Click="Refresh_Click" DockPanel.Dock="Right" Padding="8,3" /><TextBlock x:Name="StashesCount" Text="{local:Loc 'Сохранения'}" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
        <ListBox x:Name="StashesList" Grid.Row="1" SelectionChanged="Stash_Changed" AutomationProperties.Name="{local:Loc 'Список сохранённых изменений'}" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
          <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,5" ToolTip="{Binding Hash}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Reference}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
            <TextBlock Text="{Binding CreatedAt.LocalDateTime,StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
          </StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyStashes" Grid.Row="1" Text="{local:Loc 'Сохранений пока нет'}" Foreground="{DynamicResource MutedBrush}" Margin="12" TextWrapping="Wrap" Visibility="Collapsed" IsHitTestVisible="False" />
      </Grid>
      <GridSplitter Grid.Column="1" Width="7" Background="{DynamicResource BackgroundBrush}" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
      <Grid Grid.Column="2" Margin="8,0,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
        <TextBlock x:Name="FilesCount" Text="{local:Loc 'Файлы'}" FontWeight="SemiBold" Margin="0,5,0,8" />
        <ComboBox x:Name="ScopePicker" Grid.Row="1" SelectedIndex="0" SelectionChanged="Scope_Changed" Margin="0,0,0,8" AutomationProperties.Name="{local:Loc 'Содержимое сохранения'}">
          <ComboBoxItem Content="{local:Loc 'Рабочие файлы'}" />
          <ComboBoxItem Content="{local:Loc 'Индекс (staged)'}" />
        </ComboBox>
        <ListBox x:Name="FilesList" Grid.Row="2" ItemTemplate="{StaticResource ChangedFileTemplate}" SelectionChanged="File_Changed" AutomationProperties.Name="{local:Loc 'Файлы сохранения'}" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource FileRow}"><Setter Property="Tag" Value="{Binding StatusDescription}" /><Setter Property="ToolTip" Value="{Binding DisplayPath}" /></Style></ListBox.ItemContainerStyle>
        </ListBox>
      </Grid>
      <GridSplitter Grid.Column="3" Width="7" Background="{DynamicResource BackgroundBrush}" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
      <Grid Grid.Column="4" Margin="8,0,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock x:Name="FileTitle" Text="{local:Loc 'Выберите сохранение'}" TextTrimming="CharacterEllipsis" Margin="0,5,0,12" />
        <local:DiffView x:Name="DiffViewer" Grid.Row="1" Visibility="Collapsed" />
        <WrapPanel x:Name="ActionsPanel" Grid.Row="2" Margin="0,12,0,0">
          <Button x:Name="ApplyButton" Content="{local:Loc 'Применить'}" Click="Apply_Click" Margin="0,0,8,0" IsEnabled="False" ToolTip="{local:Loc 'Вернуть изменения, сохранив stash в списке.'}" />
          <Button x:Name="PopButton" Content="{local:Loc 'Применить и удалить'}" Click="Pop_Click" Margin="0,0,8,0" IsEnabled="False" ToolTip="{local:Loc 'Удалить stash только после успешного применения. При конфликтах он сохранится.'}" />
          <Button x:Name="DropButton" Content="{local:Loc 'Удалить…'}" Click="Drop_Click" IsEnabled="False" />
        </WrapPanel>
      </Grid>
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
      <DockPanel><Button x:Name="CloseButton" DockPanel.Dock="Right" Content="{local:Loc 'Закрыть'}" IsCancel="True" Margin="12,0,0,0" /><ProgressBar x:Name="Progress" DockPanel.Dock="Left" Width="45" Height="3" IsIndeterminate="True" Margin="0,0,12,0" Visibility="Collapsed" /><TextBlock x:Name="StatusText" Text="{local:Loc 'Готово'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel>
    </Border>
  </Grid>
</Window>
