<Window x:Class="GitWork.App.FileHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GitWork.App" Title="{local:Loc 'История файла'}" Width="1320" Height="840" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}" Background="{DynamicResource BackgroundBrush}" Loaded="Window_Loaded">
  <Window.Resources>
    <Style TargetType="TabControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
              </Grid.RowDefinitions>
              <TabPanel IsItemsHost="True" Margin="0,0,0,8" />
              <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12,9" Margin="0,0,7,0">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SelectionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="350" MinWidth="270" />
      <ColumnDefinition Width="7" />
      <ColumnDefinition Width="*" MinWidth="500" />
    </Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
          <TextBlock Text="{local:Loc 'История файла'}" FontSize="21" FontWeight="SemiBold" />
          <TextBlock x:Name="FilePathText" Style="{StaticResource Caption}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </StackPanel>
        <ListBox x:Name="HistoryList" Grid.Row="1" SelectionChanged="HistoryList_SelectionChanged" AutomationProperties.Name="{local:Loc 'Версии файла'}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="2,3">
                <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Subject}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0">
                  <Run Text="{Binding ShortHash}" Foreground="{DynamicResource AccentBrush}" />
                  <Run Text=" · " />
                  <Run Text="{Binding DisplayDate, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding Author}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
          <TextBlock x:Name="HistoryStatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
          <Button x:Name="MoreButton" Content="{local:Loc 'Ещё версии'}" Click="More_Click" Visibility="Collapsed" />
        </StackPanel>
      </Grid>
    </Border>
    <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" Background="{DynamicResource BackgroundBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
    <Grid Grid.Column="2" Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock x:Name="CommitTitle" Text="{local:Loc 'Выберите версию'}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <TextBlock x:Name="RevisionPathText" Style="{StaticResource Caption}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
      </StackPanel>
      <TextBlock x:Name="LoadingText" Grid.Row="1" Text="{local:Loc 'Загрузка версии…'}" Style="{StaticResource Caption}" Margin="0,9,0,8" Visibility="Collapsed" />
      <TabControl x:Name="Views" Grid.Row="2" Margin="0,10,0,0">
        <TabItem Header="{local:Loc 'Версия'}">
          <Grid Margin="0,10,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock x:Name="SnapshotNotice" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <RichTextBox x:Name="SnapshotText" Grid.Row="1" IsReadOnly="True" IsDocumentEnabled="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="{local:Loc 'Версия файла'}" />
          </Grid>
        </TabItem>
        <TabItem Header="{local:Loc 'Изменения коммита'}">
          <local:DiffView x:Name="CommitDiffViewer" Margin="0,10,0,0" />
        </TabItem>
        <TabItem Header="{local:Loc 'С текущим файлом'}">
          <local:DiffView x:Name="WorkingDiffViewer" Margin="0,10,0,0" />
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>
