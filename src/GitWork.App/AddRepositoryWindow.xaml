<Window x:Class="GitWork.App.AddRepositoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GitWork.App" Title="{local:Loc 'Добавить репозиторий · Git Work'}" Width="680" Height="580" MinWidth="580" MinHeight="500" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner" Closing="Window_Closing">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,22">
      <TextBlock Text="{local:Loc 'Добавить репозиторий'}" FontSize="26" FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
        <RadioButton x:Name="DiskMode" Content="{local:Loc 'С диска'}" GroupName="SourceMode" Style="{StaticResource NavigationTab}" IsChecked="True" Checked="Mode_Checked" />
        <RadioButton x:Name="UrlMode" Content="{local:Loc 'По URL'}" GroupName="SourceMode" Style="{StaticResource NavigationTab}" Checked="Mode_Checked" Margin="8,0,0,0" />
      </StackPanel>
    </StackPanel>
    <Grid x:Name="FormPanel" Grid.Row="1">
      <Grid x:Name="DiskPanel" Visibility="Visible">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Text="{local:Loc 'Выберите папку обычного репозитория или конкретного worktree.'}" Style="{StaticResource Caption}" Margin="0,0,0,12" />
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBox x:Name="DiskPathBox" AutomationProperties.Name="{local:Loc 'Папка репозитория'}" />
          <Button Grid.Column="1" Content="{local:Loc 'Обзор…'}" Click="BrowseDisk_Click" Margin="8,0,0,0" />
        </Grid>
      </Grid>
      <Grid x:Name="UrlPanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
          <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Text="{local:Loc 'URL или SSH-адрес репозитория'}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
        <TextBox x:Name="UrlBox" Grid.Row="1" TextChanged="UrlBox_TextChanged" AutomationProperties.Name="{local:Loc 'URL репозитория'}" />
        <TextBlock Grid.Row="2" Text="{local:Loc 'Родительская папка'}" Style="{StaticResource Caption}" Margin="0,18,0,8" />
        <Grid Grid.Row="3">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBox x:Name="ParentFolderBox" AutomationProperties.Name="{local:Loc 'Родительская папка репозитория'}" />
          <Button Grid.Column="1" Content="{local:Loc 'Обзор…'}" Click="BrowseParent_Click" Margin="8,0,0,0" />
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,18,0,0">
          <TextBlock Text="{local:Loc 'Имя новой папки'}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
          <TextBox x:Name="FolderNameBox" AutomationProperties.Name="{local:Loc 'Имя новой папки'}" />
          <TextBlock Text="{local:Loc 'Git Credential Manager запросит доступ, если он нужен.'}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
        </StackPanel>
      </Grid>
    </Grid>
    <Grid Grid.Row="2" Margin="0,18,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock x:Name="ValidationText" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,5,0,0">
          <ProgressBar IsIndeterminate="True" Height="4" />
          <TextBlock x:Name="ProgressText" Style="{StaticResource Caption}" Margin="0,7,0,0" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,16,0,0">
        <Button x:Name="CancelButton" Content="{local:Loc 'Отмена'}" IsCancel="True" Margin="0,0,10,0" />
        <Button x:Name="AddButton" Content="{local:Loc 'Добавить'}" Style="{StaticResource PrimaryButton}" Click="Add_Click" IsDefault="True" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
