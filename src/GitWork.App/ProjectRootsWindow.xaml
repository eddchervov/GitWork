<Window x:Class="GitWork.App.ProjectRootsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GitWork.App" Title="{local:Loc 'Папки поиска worktree · Git Work'}" Width="650" Height="550" MinWidth="500" MinHeight="430" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="{local:Loc 'Папки поиска worktree'}" FontSize="26" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1" Text="{local:Loc 'Здесь приложение находит репозитории и их связанные worktree. Во вкладку «Репозитории» они автоматически не добавляются.'}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
    <ListBox Grid.Row="2" x:Name="RootsList" AutomationProperties.Name="{local:Loc 'Папки поиска worktree'}" Margin="0,16,0,0">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,15,0,0">
      <Button Content="{local:Loc '＋ Добавить папку'}" Click="Add_Click" />
      <Button Content="{local:Loc 'Убрать из списка'}" Click="Remove_Click" Margin="10,0,0,0" ToolTip="{local:Loc 'Папка и файлы на диске сохраняются'}" />
    </StackPanel>
    <StackPanel Grid.Row="4" Margin="0,22,0,0">
      <TextBlock x:Name="ValidationText" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,10" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{local:Loc 'Отмена'}" IsCancel="True" Margin="0,0,10,0" />
        <Button Content="{local:Loc 'Сохранить'}" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
