<UserControl x:Class="GitWork.App.ChangesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GitWork.App" Background="{DynamicResource BackgroundBrush}" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="310" MinWidth="250" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" MinWidth="200" /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition MinHeight="48" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Text="{local:Loc 'Файлы'}" FontSize="16" FontWeight="SemiBold" />
        <ComboBox x:Name="RepositoryPicker" Grid.Row="1" Margin="0,6,0,0" DisplayMemberPath="Name" SelectionChanged="RepositoryPicker_SelectionChanged" AutomationProperties.Name="{local:Loc 'Репозиторий для коммита'}" Visibility="Collapsed" />
        <Grid Grid.Row="2" Margin="0,10,0,8">
          <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="{local:Loc 'Поиск по имени файла'}" AutomationProperties.Name="{local:Loc 'Поиск файлов'}" />
          <TextBlock Text="{local:Loc 'Поиск файлов…'}" IsHitTestVisible="False" Margin="10,0" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding Text.Length,ElementName=SearchBox}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <CheckBox x:Name="SelectAllBox" Grid.Row="3" Content="{local:Loc 'Все файлы'}" Margin="4,2,0,8" IsThreeState="True" Click="SelectAll_Click" ToolTip="{local:Loc 'Включить или исключить все файлы репозитория, включая скрытые поиском'}" />
        <Grid Grid.Row="4">
          <ListBox x:Name="FilesList" SelectionMode="Single" SelectionChanged="FilesList_SelectionChanged" AutomationProperties.Name="{local:Loc 'Изменённые файлы'}" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource FileRow}"><Setter Property="Tag" Value="{Binding File.StatusDescription}" /><Setter Property="ToolTip" Value="{Binding FullPath}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsIncluded,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{local:Loc 'Включить файл целиком в коммит'}" AutomationProperties.Name="{Binding File.DisplayPath}" />
                  <TextBlock Grid.Column="1" Text="{Binding File.DisplayPath}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding File.StatusDescription,Converter={x:Static local:L10n.StringConverter}}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="EmptyText" Text="{local:Loc 'Изменённых файлов нет'}" Foreground="{DynamicResource MutedBrush}" Margin="12" Visibility="Collapsed" IsHitTestVisible="False" />
        </Grid>
        <Border Grid.Row="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0" MaxHeight="180">
          <DockPanel>
            <Button x:Name="CommitButton" DockPanel.Dock="Bottom" Content="{local:Loc 'Создать коммит'}" Click="Commit_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Padding="12,7" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
            <TextBlock x:Name="CommitSelectionText" FontWeight="SemiBold" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,8">
              <TextBox x:Name="CommitTitleBox" TextChanged="CommitMessage_TextChanged" MaxLength="500" Padding="10,6" AutomationProperties.Name="{local:Loc 'Название коммита'}" ToolTip="{local:Loc 'Название коммита'}" />
              <TextBlock Text="{local:Loc 'Название коммита'}" IsHitTestVisible="False" Margin="10,0" VerticalAlignment="Center">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text.Length,ElementName=CommitTitleBox}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </Grid>
            <Grid Margin="0,0,0,8">
              <TextBox x:Name="CommitDescriptionBox" TextChanged="CommitMessage_TextChanged" AcceptsReturn="True" TextWrapping="Wrap" Height="46" Padding="10,6" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{local:Loc 'Описание коммита'}" ToolTip="{local:Loc 'Описание (необязательно)'}" />
              <TextBlock Text="{local:Loc 'Описание (необязательно)'}" IsHitTestVisible="False" Margin="10,10" VerticalAlignment="Top">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text.Length,ElementName=CommitDescriptionBox}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </Grid>
            <ProgressBar x:Name="CommitProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8" />
            <TextBlock x:Name="CommitStatusText" TextWrapping="Wrap" MaxHeight="64" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" Visibility="Collapsed" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Border>
    <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" Background="{DynamicResource BackgroundBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
    <Grid Grid.Column="2" Margin="14">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
      <TextBox x:Name="FileTitle" Text="{local:Loc 'Выберите файл'}" Style="{StaticResource SelectableText}" FontSize="17" FontWeight="SemiBold" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" />
      <DockPanel Grid.Row="1" Margin="0,6,0,10">
        <Button x:Name="HistoryButton" Content="{local:Loc 'История файла…'}" DockPanel.Dock="Right" Click="History_Click" Padding="10,6" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="FileContext" Style="{StaticResource Caption}" />
          <TextBlock x:Name="LoadingText" Text="{local:Loc 'Чтение изменений…'}" Style="{StaticResource Caption}" Margin="14,0,0,0" Visibility="Collapsed" />
        </StackPanel>
      </DockPanel>
      <local:DiffView x:Name="DiffViewer" Grid.Row="2" IsUnified="True" />
    </Grid>
  </Grid>
</UserControl>
