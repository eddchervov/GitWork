<Window x:Class="GitWork.App.PreparationRunWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GitWork.App" Title="{local:Loc 'Подготовка'}" Width="940" Height="700" MinWidth="720" MinHeight="480" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}" Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="ProfileTitle" FontSize="17" FontWeight="SemiBold" />
      <TextBox x:Name="RootPathText" Style="{StaticResource SelectableText}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,12" />
    </StackPanel>
    <ItemsControl x:Name="StepsList" Grid.Row="1" MaxHeight="200">
      <ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate></ItemsControl.Template>
      <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /><ColumnDefinition Width="160" /><ColumnDefinition Width="65" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Number}" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /><TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding StatusBrush}" TextAlignment="Right" /><TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="{DynamicResource MutedBrush}" TextAlignment="Right" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock x:Name="StatusText" Grid.Row="2" Text="{local:Loc 'Подготовка к запуску…'}" Margin="0,12,0,8" />
    <TextBox x:Name="OutputBox" Grid.Row="3" IsReadOnly="True" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{local:Loc 'Вывод команд подготовки'}" />
    <StackPanel Grid.Row="4" Margin="0,10,0,0"><ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" /><TextBlock Text="{local:Loc 'Рабочие копии сохранены. Ошибка или остановка подготовки не удаляет worktree.'}" Style="{StaticResource Caption}" Margin="0,8,0,0" /></StackPanel>
    <DockPanel Grid.Row="5" LastChildFill="False" Margin="0,16,0,0">
      <Button Content="{local:Loc 'Открыть папку'}" Click="OpenFolder_Click" DockPanel.Dock="Left" Margin="0,0,8,0" />
      <Button x:Name="SaveLogButton" Content="{local:Loc 'Сохранить журнал…'}" Click="SaveLog_Click" DockPanel.Dock="Left" />
      <Button x:Name="RetryButton" Content="{local:Loc 'Повторить шаг'}" Click="Retry_Click" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Margin="8,0,0,0" />
      <Button x:Name="CloseButton" Content="{local:Loc 'Остановить'}" Click="Close_Click" DockPanel.Dock="Right" />
    </DockPanel>
  </Grid>
</Window>
