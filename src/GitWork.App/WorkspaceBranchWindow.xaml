<Window x:Class="GitWork.App.WorkspaceBranchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GitWork.App" Title="{local:Loc 'Ветка комплекта · Git Work'}" Width="800" Height="620" MinWidth="680" MinHeight="480" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,22"><TextBlock Text="{local:Loc 'Новая ветка комплекта'}" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="WorkspaceLabel" Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,20"><TextBlock Text="{local:Loc 'Имя ветки'}" Style="{StaticResource Caption}" Margin="0,0,0,8"/><TextBox x:Name="BranchNameBox" Text="feature/" AutomationProperties.Name="{local:Loc 'Ветка комплекта'}"/></StackPanel>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="ChoicesList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,10">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsIncluded,Mode=TwoWay}" IsEnabled="{Binding IsAvailable}" VerticalAlignment="Center">
                  <StackPanel Margin="0,0,10,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding BranchLabel}" Style="{StaticResource Caption}" Margin="0,4,0,0"/><TextBlock Text="{Binding Error}" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                </CheckBox>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource,Mode=TwoWay}" DisplayMemberPath="DisplayName" IsEnabled="{Binding IsAvailable}" VerticalAlignment="Center" AutomationProperties.Name="{local:Loc 'Исходная ветка репозитория'}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Grid Grid.Row="3" Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="ValidationText" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,12"/>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{local:Loc 'Отмена'}" IsCancel="True" Margin="0,0,10,0"/><Button Content="{local:Loc 'Создать и переключить'}" Click="Create_Click" IsDefault="True" Style="{StaticResource PrimaryButton}"/></StackPanel>
    </Grid>
  </Grid>
</Window>
