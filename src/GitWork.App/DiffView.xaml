<UserControl x:Class="GitWork.App.DiffView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GitWork.App" x:Name="View" PreviewKeyDown="View_PreviewKeyDown">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,10"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="{local:Loc 'Копировать diff'}" Click="CopyDiff_Click" Padding="9,5" Margin="0,0,10,0" /><Button x:Name="PreviousButton" Content="↑" Click="PreviousChange_Click" Padding="9,5" ToolTip="{local:Loc 'Предыдущий блок (Shift+F7)'}" /><TextBlock x:Name="ChangeCounter" Text="0/0" VerticalAlignment="Center" MinWidth="40" TextAlignment="Center" Style="{StaticResource Caption}" /><Button x:Name="NextChangeButton" Content="↓" Click="NextChange_Click" Padding="9,5" ToolTip="{local:Loc 'Следующий блок (F7)'}" /></StackPanel><CheckBox x:Name="UnifiedToggle" Content="{local:Loc 'Одна колонка'}" VerticalAlignment="Center" IsChecked="{Binding IsUnified, ElementName=View, Mode=TwoWay}" /></DockPanel>
    <Border x:Name="MessageBorder" Grid.Row="1" Background="{DynamicResource RaisedBrush}" Padding="10,8" Margin="0,0,0,8" Visibility="Collapsed"><TextBox x:Name="MessageText" Style="{StaticResource SelectableText}" Foreground="{DynamicResource WarningBrush}" /></Border>
    <Grid x:Name="ColumnHeaders" Grid.Row="2" Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="{local:Loc 'Было'}" Style="{StaticResource Caption}" Margin="8,0" /><TextBlock Grid.Column="1" Text="{local:Loc 'Стало'}" Style="{StaticResource Caption}" Margin="8,0" /></Grid>
    <RichTextBox x:Name="CodeViewer" Grid.Row="3" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0" Padding="0" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{local:Loc 'Код изменений — можно выделить и скопировать'}" />
  </Grid>
</UserControl>
