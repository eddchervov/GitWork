<UserControl x:Class="GitWork.App.DiffView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GitWork.App" x:Name="View" PreviewKeyDown="View_PreviewKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,1" Height="32" Background="{DynamicResource SurfaceBrush}">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
        <TextBlock x:Name="DiffStats" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"><Run x:Name="AddedLinesText" Foreground="{DynamicResource AddedTextBrush}" /><Run Text="  " /><Run x:Name="RemovedLinesText" Foreground="{DynamicResource DeletedTextBrush}" /></TextBlock>
        <CheckBox x:Name="UnifiedToggle" Content="{local:Loc 'Одна колонка'}" VerticalAlignment="Center" IsChecked="{Binding IsUnified, ElementName=View, Mode=TwoWay}" Margin="0,0,8,0" />
        <Button x:Name="CopyDiffButton" Click="CopyDiff_Click" Padding="5,3" Margin="0,0,4,0" ToolTip="{local:Loc 'Копировать diff'}" AutomationProperties.Name="{local:Loc 'Копировать diff'}">
          <Canvas Width="14" Height="14"><Rectangle Canvas.Left="1" Canvas.Top="1" Width="8" Height="9" Stroke="{DynamicResource TextBrush}" /><Rectangle Canvas.Left="5" Canvas.Top="5" Width="8" Height="8" Fill="{DynamicResource RaisedBrush}" Stroke="{DynamicResource TextBrush}" /></Canvas>
        </Button>
        <Button x:Name="PreviousButton" Content="↑" Click="PreviousChange_Click" Padding="7,3" ToolTip="{local:Loc 'Предыдущий блок (Shift+F7)'}" />
        <TextBlock x:Name="ChangeCounter" Text="0/0" VerticalAlignment="Center" MinWidth="34" TextAlignment="Center" Style="{StaticResource Caption}" />
        <Button x:Name="NextChangeButton" Content="↓" Click="NextChange_Click" Padding="7,3" ToolTip="{local:Loc 'Следующий блок (F7)'}" />
      </StackPanel>
      <ContentControl Content="{Binding Header, ElementName=View}" VerticalAlignment="Center" />
    </DockPanel>
    <Border x:Name="MessageBorder" Grid.Row="1" Background="{DynamicResource RaisedBrush}" Padding="8,5" Margin="0,0,0,5" Visibility="Collapsed"><TextBox x:Name="MessageText" Style="{StaticResource SelectableText}" Foreground="{DynamicResource WarningBrush}" /></Border>
    <Grid x:Name="ColumnHeaders" Grid.Row="2" Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="{local:Loc 'Было'}" Style="{StaticResource Caption}" Margin="6,0" /><TextBlock Grid.Column="1" Text="{local:Loc 'Стало'}" Style="{StaticResource Caption}" Margin="6,0" /></Grid>
    <RichTextBox x:Name="CodeViewer" Grid.Row="3" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0" Padding="0" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="13" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{local:Loc 'Код изменений — можно выделить и скопировать'}" />
  </Grid>
</UserControl>
