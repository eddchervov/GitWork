<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>GitWork.App.Program</StartupObject>
    <AssemblyName>GitWork</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <EmbeddedResource Include="Resources\en.json" />
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\GitWork.png" />
    <ProjectReference Include="..\GitWork.Core\GitWork.Core.csproj" />
  </ItemGroup>
</Project>
