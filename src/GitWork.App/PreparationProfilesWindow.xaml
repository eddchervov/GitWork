<Window x:Class="GitWork.App.PreparationProfilesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GitWork.App" Title="{local:Loc 'Профили подготовки · Git Work'}" Width="900" Height="760" MinWidth="800" MinHeight="620" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="280" /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <TextBlock Text="{local:Loc 'Профиль'}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox x:Name="ProfilePicker" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="Profile_Changed" />
      <Button Grid.Column="2" Content="{local:Loc 'Новый'}" Click="NewProfile_Click" Margin="8,0,0,0" Padding="8,4" />
      <Button x:Name="DeleteProfileButton" Grid.Column="3" Content="{local:Loc 'Удалить профиль'}" Click="DeleteProfile_Click" Margin="8,0,0,0" Padding="8,4" HorizontalAlignment="Left" />
    </Grid>
    <Grid Grid.Row="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Text="{local:Loc 'Название профиля'}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox x:Name="ProfileNameBox" Grid.Column="1" TextChanged="ProfileName_Changed" />
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="270" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock Text="{local:Loc 'Шаги'}" FontWeight="SemiBold" Margin="0,0,0,6" />
          <ListBox x:Name="StepsList" Grid.Row="1" SelectionChanged="Step_Changed" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{local:Loc 'Шаги подготовки'}">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="4,3" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="{local:Loc 'Выполнять этот шаг'}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel Grid.Row="2" Margin="0,8,0,0">
            <Button Content="{local:Loc '+ Добавить шаг'}" Click="AddStep_Click" Padding="6,4" Margin="0,0,4,0" />
            <Button Content="↑" Click="MoveStepUp_Click" Padding="7,4" Margin="0,0,4,0" ToolTip="{local:Loc 'Переместить выше'}" />
            <Button Content="↓" Click="MoveStepDown_Click" Padding="7,4" Margin="0,0,4,0" ToolTip="{local:Loc 'Переместить ниже'}" />
            <Button Content="×" Click="DeleteStep_Click" Padding="8,4" ToolTip="{local:Loc 'Удалить шаг'}" />
          </WrapPanel>
        </Grid>
        <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource BorderBrush}" />
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
          <StackPanel>
            <TextBlock Text="{local:Loc 'Настройки шага'}" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="{local:Loc 'Название'}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
            <TextBox x:Name="StepNameBox" TextChanged="StepEditor_Changed" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{local:Loc 'Оболочка'}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                <ComboBox x:Name="ShellPicker" SelectedValuePath="Tag" SelectionChanged="StepEditor_Changed"><ComboBoxItem Content="CMD" Tag="CMD" /><ComboBoxItem Content="PowerShell" Tag="PowerShell" /></ComboBox>
              </StackPanel>
              <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource BorderBrush}" />
              <StackPanel Grid.Column="2">
                <TextBlock Text="{local:Loc 'Рабочая папка относительно корня'}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                <TextBox x:Name="WorkingDirectoryBox" Text="." TextChanged="StepEditor_Changed" ToolTip="{local:Loc 'Путь должен находиться внутри создаваемой папки'}" />
              </StackPanel>
            </Grid>
            <TextBlock Text="{local:Loc 'Команда'}" Style="{StaticResource Caption}" Margin="0,10,0,4" />
            <TextBox x:Name="CommandBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" Height="112" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="StepEditor_Changed" AutomationProperties.Name="{local:Loc 'Команда шага'}" />
            <TextBlock Text="{local:Loc 'Одна команда на шаг. Для нескольких CMD-скриптов добавьте отдельные шаги.'}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
            <CheckBox x:Name="StopOnErrorBox" Content="{local:Loc 'Остановить выполнение при ошибке'}" Margin="0,7,0,0" Checked="StepEditor_Changed" Unchecked="StepEditor_Changed" />
            <DockPanel Margin="0,14,0,6">
              <Button DockPanel.Dock="Right" Content="{local:Loc 'Добавить'}" Click="AddVariable_Click" Padding="7,3" />
              <TextBlock Text="{local:Loc 'Переменные окружения'}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <ListBox x:Name="VariablesList" Height="132" SelectionMode="Single" MouseDoubleClick="EditVariable_Click" AutomationProperties.Name="{local:Loc 'Переменные окружения'}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{local:Loc 'Секрет'}" Foreground="{DynamicResource MutedBrush}" Margin="8,0">
                      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsSecret}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="••••••••" Foreground="{DynamicResource MutedBrush}">
                      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsSecret}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Margin="0,5,0,0">
              <Button Content="{local:Loc 'Изменить'}" Click="EditVariable_Click" Padding="6,3" Margin="0,0,4,0" />
              <Button Content="{local:Loc 'Удалить'}" Click="DeleteVariable_Click" Padding="6,3" />
            </WrapPanel>
            <TextBlock Text="{local:Loc 'В команде CMD используйте %ИМЯ%, в PowerShell — $env:ИМЯ.'}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <TextBlock x:Name="ValidationText" Grid.Row="2" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="{local:Loc 'Отмена'}" IsCancel="True" Margin="0,0,8,0" />
      <Button Content="{local:Loc 'Сохранить профили'}" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
