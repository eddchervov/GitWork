<Window x:Class="GitWork.App.CreateProjectWorkspaceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GitWork.App" Title="{local:Loc 'Рабочий комплект · Git Work'}" Width="740" Height="730" MinWidth="620" MinHeight="580" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20">
      <TextBlock Text="{local:Loc 'Новый рабочий комплект'}" FontSize="26" FontWeight="SemiBold" />
      <TextBlock x:Name="ProjectLabel" Style="{StaticResource Caption}" Margin="0,8,0,0" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,10,0">
        <TextBlock Text="{local:Loc 'Название комплекта'}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
        <TextBox x:Name="WorkspaceNameBox" MaxLength="200" TextChanged="WorkspaceNameBox_TextChanged" AutomationProperties.Name="{local:Loc 'Название комплекта'}" />
        <TextBlock Text="{local:Loc 'Новая ветка во всех репозиториях'}" Style="{StaticResource Caption}" Margin="0,16,0,8" />
        <TextBox x:Name="BranchNameBox" Text="feature/" AutomationProperties.Name="{local:Loc 'Ветка комплекта'}" />
        <TextBlock Text="{local:Loc 'Общая папка комплекта'}" Style="{StaticResource Caption}" Margin="0,16,0,8" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TargetFolderBox" AutomationProperties.Name="{local:Loc 'Папка комплекта'}" ToolTip="{local:Loc 'Соседние папки репозиториев сохранят относительные ссылки решения'}" />
          <Button Grid.Column="1" Content="…" Click="Browse_Click" Margin="8,0,0,0" ToolTip="{local:Loc 'Выбрать родительскую папку'}" />
        </Grid>
        <TextBlock Text="{local:Loc 'Из каких веток создать рабочие копии'}" FontWeight="SemiBold" Margin="0,23,0,12" />
        <ItemsControl x:Name="RepositoriesList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="210" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{Binding Repository.Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Repository.Path}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}" DisplayMemberPath="Name" VerticalAlignment="Center" AutomationProperties.Name="{local:Loc 'Исходная ветка репозитория'}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,20,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock x:Name="ValidationText" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,12" />
      <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
        <Button Content="{local:Loc 'Отмена'}" IsCancel="True" Margin="0,0,10,0" />
        <Button Content="{local:Loc 'Создать комплект'}" Style="{StaticResource PrimaryButton}" Click="Create_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
