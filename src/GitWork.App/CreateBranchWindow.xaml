<Window x:Class="GitWork.App.CreateBranchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GitWork.App" Title="{local:Loc 'Новая ветка · Git Work'}" Width="620" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
  <StackPanel Margin="30">
    <TextBlock Text="{local:Loc 'Новая ветка'}" FontSize="26" FontWeight="SemiBold" />
    <TextBlock x:Name="WorktreeLabel" Style="{StaticResource Caption}" Margin="0,8,0,24" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
    <TextBlock Text="{local:Loc 'Имя ветки'}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
    <TextBox x:Name="BranchNameBox" Text="feature/" AutomationProperties.Name="{local:Loc 'Имя новой ветки'}" />
    <TextBlock Text="{local:Loc 'Создать от'}" Style="{StaticResource Caption}" Margin="0,18,0,8" />
    <ComboBox x:Name="StartPointPicker" DisplayMemberPath="DisplayName" AutomationProperties.Name="{local:Loc 'Исходная ветка'}" />
    <TextBlock x:Name="ValidationText" Foreground="{DynamicResource WarningBrush}" Margin="0,12,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="{local:Loc 'Отмена'}" IsCancel="True" Margin="0,0,10,0" />
      <Button Content="{local:Loc 'Создать и переключиться'}" Style="{StaticResource PrimaryButton}" Click="Create_Click" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
