<Window x:Class="GitWork.App.RemoveWorkspaceRepositoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GitWork.App" Title="{local:Loc 'Убрать репозиторий'}" Width="650" SizeToContent="Height" MinWidth="560" ResizeMode="NoResize" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="26">
    <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" />
    <TextBlock x:Name="PathText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,18" />
    <RadioButton x:Name="KeepCopyOption" GroupName="Removal" IsChecked="True" Checked="RemovalOption_Checked" Style="{StaticResource NavigationTab}">
      <TextBlock Text="{local:Loc 'Убрать только из комплекта'}" FontWeight="SemiBold" />
    </RadioButton>
    <TextBlock Text="{local:Loc 'Папка и рабочая копия Git останутся на диске.'}" Style="{StaticResource Caption}" Margin="14,0,0,14" />
    <RadioButton x:Name="DeleteCopyOption" GroupName="Removal" IsEnabled="False" Checked="RemovalOption_Checked" Style="{StaticResource NavigationTab}">
      <TextBlock Text="{local:Loc 'Удалить рабочую копию с диска'}" FontWeight="SemiBold" />
    </RadioButton>
    <TextBlock x:Name="DeleteReason" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="14,0,0,14" />
    <TextBlock x:Name="SafetyWarning" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,10,0,18" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{local:Loc 'Отмена'}" IsCancel="True" Margin="0,0,10,0" />
      <Button x:Name="ConfirmButton" Content="{local:Loc 'Убрать из комплекта'}" IsDefault="True" Click="Remove_Click" Style="{StaticResource PrimaryButton}" />
    </StackPanel>
  </StackPanel>
</Window>
