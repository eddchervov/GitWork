<Window x:Class="GitWork.App.CommitWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GitWork.App" Title="{local:Loc 'Коммит'}" Width="620" Height="600" MinWidth="500" MinHeight="450" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}" Background="{DynamicResource BackgroundBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="{local:Loc 'Коммит'}" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="{local:Loc 'Подготовленные файлы из одного репозитория.'}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
    </StackPanel>
    <ComboBox x:Name="RepositoryPicker" Grid.Row="1" Margin="0,16,0,10" SelectionChanged="RepositoryPicker_SelectionChanged" AutomationProperties.Name="{local:Loc 'Репозиторий для коммита'}" />
    <ListBox x:Name="StagedFilesList" Grid.Row="2" AutomationProperties.Name="{local:Loc 'Подготовленные файлы для коммита'}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <TextBlock Text="{local:Loc 'Сообщение'}" FontWeight="SemiBold" Margin="0,0,0,6" />
      <TextBox x:Name="MessageBox" MinHeight="76" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" AutomationProperties.Name="{local:Loc 'Сообщение коммита'}" />
      <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="0,7,0,0" TextWrapping="Wrap" />
      <TextBlock Text="{local:Loc 'Git hooks могут изменить состав коммита.'}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
    </StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="{local:Loc 'Закрыть'}" IsCancel="True" Margin="0,0,8,0" />
      <Button x:Name="CommitActionButton" Content="{local:Loc 'Создать коммит'}" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="CommitAction_Click" />
    </StackPanel>
  </Grid>
</Window>
