<Window x:Class="GitWork.App.WorkspaceNameWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GitWork.App" Title="{local:Loc 'Название комплекта'}" Width="530" SizeToContent="Height" ResizeMode="NoResize" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="26">
    <TextBlock Text="{local:Loc 'Название комплекта'}" FontSize="23" FontWeight="SemiBold" />
    <TextBox x:Name="NameBox" Margin="0,18,0,18" MaxLength="200" AutomationProperties.Name="{local:Loc 'Название комплекта'}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{local:Loc 'Отмена'}" IsCancel="True" Margin="0,0,10,0" />
      <Button Content="{local:Loc 'Сохранить'}" IsDefault="True" Click="Save_Click" Style="{StaticResource PrimaryButton}" />
    </StackPanel>
  </StackPanel>
</Window>
