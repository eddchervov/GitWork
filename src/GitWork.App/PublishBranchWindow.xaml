<Window x:Class="GitWork.App.PublishBranchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GitWork.App" Title="{local:Loc 'Опубликовать ветку'}" Width="580" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
  <StackPanel Margin="24">
    <TextBlock Text="{local:Loc 'Опубликовать ветку'}" FontSize="20" FontWeight="SemiBold" />
    <TextBlock x:Name="SourceText" Margin="0,8,0,4" TextWrapping="Wrap" />
    <TextBlock x:Name="WorktreeText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" Margin="0,0,0,18" />
    <TextBlock Text="{local:Loc 'Сервер'}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
    <ComboBox x:Name="RemotePicker" DisplayMemberPath="Name" SelectionChanged="Destination_Changed" AutomationProperties.Name="{local:Loc 'Сервер для публикации'}" />
    <TextBlock Text="{local:Loc 'Имя ветки на сервере'}" Style="{StaticResource Caption}" Margin="0,14,0,6" />
    <TextBox x:Name="BranchNameBox" TextChanged="BranchName_Changed" AutomationProperties.Name="{local:Loc 'Имя ветки на сервере'}" />
    <TextBlock x:Name="DestinationText" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" />
    <TextBlock Text="{local:Loc 'На сервере будет создана новая ветка с историей коммитов. После отправки она станет upstream для этой локальной ветки.'}" TextWrapping="Wrap" Margin="0,16,0,0" />
    <TextBlock x:Name="ValidationText" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="{local:Loc 'Отмена'}" IsCancel="True" Margin="0,0,8,0" />
      <Button x:Name="PublishButton" Content="{local:Loc 'Опубликовать'}" Style="{StaticResource PrimaryButton}" Click="Publish_Click" />
    </StackPanel>
  </StackPanel>
</Window>
